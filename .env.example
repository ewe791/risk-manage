# ===== 数据库 =====
# 生产：PostgreSQL 15
# DATABASE_URL=postgresql+psycopg://risk:risk@127.0.0.1:5432/risk_agent
# 本地降级：SQLite
DATABASE_URL=sqlite:///./risk_agent.db

# ===== Redis（会话 / Agent 上下文），为空时自动降级为进程内缓存 =====
REDIS_URL=
CONVERSATION_TTL_SECONDS=86400

# ===== LLM（OpenAI 兼容接口） =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-8ad7ba97b6744349b37b4b7c7daae2e6
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2

# ===== JWT =====
JWT_SECRET=change-me-in-production-please-use-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# ===== 操作员账号（user:pass:role，逗号分隔）=====
# admin 风控管理员 / reviewer 风控审核员 / viewer 数据查看人（只读）
AUTH_OPERATORS=admin:Admin@12345:admin,reviewer:Reviewer@12345:reviewer,viewer:Viewer@12345:viewer

# ===== 上游业务数据源（Mock 订单/用户服务） =====
UPSTREAM_DATA_DIR=./seed

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
